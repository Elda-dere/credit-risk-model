    "outliers = positive_amounts[(positive_amounts < Q1 - 1.5 * IQR) | (positive_amounts > Q3 + 1.5 * IQR)]\n",
    "\n",
    "print(f\"Number of outliers in Amount: {len(outliers):,} ({len(outliers)/len(positive_amounts)*100:.2f}%)\")"
